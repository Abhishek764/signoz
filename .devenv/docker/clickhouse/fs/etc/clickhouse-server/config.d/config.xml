<clickhouse replace="true">
    <logger>
        <level>information</level>
        <formatting>
            <type>json</type>
        </formatting>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>3</count>
    </logger>
    <display_name>cluster</display_name>
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <user_directories>
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <local_directory>
            <path>/var/lib/clickhouse/access/</path>
        </local_directory>
    </user_directories>
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
    <zookeeper>
        <node>
            <host>zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
    <macros>
        <shard>01</shard>
        <replica>01</replica>
    </macros>
    <user_defined_executable_functions_config>*function.xml</user_defined_executable_functions_config>
    <user_scripts_path>/var/lib/clickhouse/user_scripts/</user_scripts_path>
    <merge_tree>
        <!--
            ClickHouse 26.x rejects AggregatingMergeTree tables carrying non-key,
            non-aggregate columns unless this setting is enabled. SigNoz's metrics-metadata
            schema does exactly that (description, unit, type, is_monotonic), so the schema
            migrator fails on 26.7+ with BAD_ARGUMENTS without it. See SigNoz/signoz#12257.
        -->
        <allow_dimensions_outside_sorting_key>1</allow_dimensions_outside_sorting_key>
    </merge_tree>
</clickhouse>